{
  "name": "commish-mcp",
  "version": "0.1.0",
  "description": "MCP server for fantasy sports league commissioners",
  "type": "module",
  "license": "MIT",
  "author": "Alex Mills",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexmillsnl/commish-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "fantasy-football",
    "fantasy-sports",
    "yahoo",
    "commissioner"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "bin": {
    "commish-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
